{
  "profile_name": "Стандартный OBD-II (ELM327, любой автомобиль)",
  "profile_version": "1.0",
  "description": "Эталонный профиль режимов 01/09 по ISO 15031-5: работает на любом автомобиле с любым ELM327. Без протокола (адаптер сам ищет, как в obd_log.txt: ATSP0 → автоопределение CAN 11bit) и без CAN-заголовков: запросы идут на функциональный адрес 7DF, фильтр ответов авто (ATAR). Формулы — из SAE J1979; по ответам лога Chery сверены (ОЖ 66 °C, ХХ 930 об/мин, MAP 29 кПа, баро 99 кПа, лямбда 0,996, 14,14 В, −15 °C за бортом). Приборка/блоки без поддержки отвечают «н/д» и опрашиваются реже — это нормально.",
  "connection_settings": {
    "timeout": 2000
  },
  "parameters": {
    "engine": [
      { "name": "Обороты двигателя", "short_name": "RPM", "command": "010C",
        "formula": "((A*256)+B)/4", "unit": "об/мин", "min": 0, "max": 7000, "precision": 0 },
      { "name": "Скорость автомобиля", "short_name": "Speed", "command": "010D",
        "formula": "A", "unit": "км/ч", "min": 0, "max": 250, "precision": 0 },
      { "name": "Температура ОЖ двигателя", "short_name": "Coolant", "command": "0105",
        "formula": "A-40", "unit": "°C", "min": -40, "max": 115, "precision": 0 },
      { "name": "Температура всасываемого воздуха", "short_name": "IAT", "command": "010F",
        "formula": "A-40", "unit": "°C", "min": -40, "max": 80, "precision": 0 },
      { "name": "Расчётная нагрузка двигателя", "short_name": "Load", "command": "0104",
        "formula": "(A*100)/255", "unit": "%", "min": 0, "max": 100, "precision": 1 },
      { "name": "Абсолютная нагрузка двигателя", "short_name": "Load abs", "command": "0143",
        "formula": "((A*256)+B)*100/255", "unit": "%", "min": 0, "max": 400, "precision": 1 },
      { "name": "Давление во впускном коллекторе (MAP)", "short_name": "MAP", "command": "010B",
        "formula": "A", "unit": "кПа", "min": 0, "max": 255, "precision": 0 },
      { "name": "Атмосферное давление", "short_name": "Baro", "command": "0133",
        "formula": "A", "unit": "кПа", "min": 70, "max": 110, "precision": 0 },
      { "name": "Опережение зажигания", "short_name": "Timing", "command": "010E",
        "formula": "(A/2)-64", "unit": "°", "min": -64, "max": 64, "precision": 1 },
      { "name": "Положение дроссельной заслонки", "short_name": "TPS", "command": "0111",
        "formula": "(A*100)/255", "unit": "%", "min": 0, "max": 100, "precision": 1 },
      { "name": "Относительное положение дросселя", "short_name": "TPS rel", "command": "0145",
        "formula": "(A*100)/255", "unit": "%", "min": 0, "max": 100, "precision": 1 },
      { "name": "Заданное положение дросселя", "short_name": "TPS cmd", "command": "014C",
        "formula": "(A*100)/255", "unit": "%", "min": 0, "max": 100, "precision": 1 },
      { "name": "Педаль акселератора", "short_name": "Pedal", "command": "0149",
        "formula": "(A*100)/255", "unit": "%", "min": 0, "max": 100, "precision": 1 },
      { "name": "Температура масла двигателя", "short_name": "Oil T", "command": "015C",
        "formula": "A-40", "unit": "°C", "min": -40, "max": 150, "precision": 0 },
      { "name": "Температура наружного воздуха", "short_name": "Ambient", "command": "0146",
        "formula": "A-40", "unit": "°C", "min": -40, "max": 60, "precision": 0 },
      { "name": "Время работы двигателя с запуска", "short_name": "Run time", "command": "011F",
        "formula": "(A*256)+B", "unit": "с", "min": 0, "max": 65535, "precision": 0 }
    ],
    "fuel_system": [
      { "name": "Состояние топливной системы", "short_name": "Fuel sys", "command": "0103",
        "formula": "A", "unit": "", "precision": 0,
        "note": "1=OL холодный, 2=CL, 4=OL нагрузка, 8=OL сбой, 16=CL сбой датчика" },
      { "name": "Краткосрочная коррекция топлива (Bank 1)", "short_name": "STFT1", "command": "0106",
        "formula": "((A-128)*100)/128", "unit": "%", "min": -25, "max": 25, "precision": 1 },
      { "name": "Долгосрочная коррекция топлива (Bank 1)", "short_name": "LTFT1", "command": "0107",
        "formula": "((A-128)*100)/128", "unit": "%", "min": -25, "max": 25, "precision": 1 },
      { "name": "Краткосрочная коррекция топлива (Bank 2)", "short_name": "STFT2", "command": "0108",
        "formula": "((A-128)*100)/128", "unit": "%", "min": -25, "max": 25, "precision": 1,
        "note": "4-цилиндровым двигателям недоступна (Bank 2 нет)" },
      { "name": "Долгосрочная коррекция топлива (Bank 2)", "short_name": "LTFT2", "command": "0109",
        "formula": "((A-128)*100)/128", "unit": "%", "min": -25, "max": 25, "precision": 1 },
      { "name": "Лямбда (ШДК, Bank 1 Sensor 1)", "short_name": "Lambda", "command": "0134",
        "formula": "((A*256)+B)*2/65536", "unit": "λ", "min": 0.5, "max": 1.5, "precision": 3 },
      { "name": "Заданная лямбда", "short_name": "Lambda cmd", "command": "0144",
        "formula": "((A*256)+B)*2/65536", "unit": "λ", "min": 0.5, "max": 1.5, "precision": 3 },
      { "name": "Давление в топливной рампе (прямой впрыск)", "short_name": "Fuel rail", "command": "0123",
        "formula": "((A*256)+B)/10", "unit": "бар", "min": 0, "max": 350, "precision": 1,
        "note": "у моторов с распределённым впрыском параметры 0123/0125 не поддерживаются" },
      { "name": "Уровень топлива", "short_name": "Fuel", "command": "012F",
        "formula": "(A*100)/255", "unit": "%", "min": 0, "max": 100, "precision": 0 },
      { "name": "Расход топлива (инжектор)", "short_name": "Fuel rate", "command": "015D",
        "formula": "((A*256)+B)/20", "unit": "л/ч", "min": 0, "max": 50, "precision": 1 }
    ],
    "emissions": [
      { "name": "Лампа Check Engine", "short_name": "MIL", "command": "0101",
        "formula": "(A>>7)&1", "unit": "", "precision": 0,
        "note": "0=выкл, 1=горит" },
      { "name": "Количество ошибок (DTC)", "short_name": "DTC", "command": "0101",
        "formula": "A&127", "unit": "", "min": 0, "max": 0, "precision": 0 },
      { "name": "Напряжение датчика O2 (Bank 1, Sensor 2)", "short_name": "O2 B1S2", "command": "0115",
        "formula": "A/200", "unit": "В", "min": 0, "max": 1.275, "precision": 3 },
      { "name": "Температура катализатора (Bank 1, Sensor 1)", "short_name": "CAT B1S1", "command": "013C",
        "formula": "((A*256)+B)/10-40", "unit": "°C", "min": -40, "max": 950, "precision": 0 },
      { "name": "Продувка адсорбера EVAP (заданная)", "short_name": "EVAP", "command": "012E",
        "formula": "(A*100)/255", "unit": "%", "min": 0, "max": 100, "precision": 1 },
      { "name": "Пробег с момента сброса ошибок", "short_name": "Dist clr", "command": "0131",
        "formula": "(A*256)+B", "unit": "км", "precision": 0 },
      { "name": "Прогревов с момента сброса ошибок", "short_name": "Warmups", "command": "0130",
        "formula": "A", "unit": "", "precision": 0 }
    ],
    "electrical": [
      { "name": "Напряжение бортсети (ЭБУ)", "short_name": "ECU V", "command": "0142",
        "formula": "((A*256)+B)/1000", "unit": "В", "min": 11, "max": 15.5, "precision": 2,
        "note": "напряжение самого адаптера всегда видно по ATRV, даже если ЭБУ молчит" }
    ]
  },
  "vehicle_information": {
    "vin": { "command": "0902" },
    "calibration_id": { "command": "0904" },
    "ecu_name": { "command": "090A" }
  }
}
